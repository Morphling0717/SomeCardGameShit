[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/UI/ConfirmationPanel.cs" id="1_script"]

[node name="ConfirmationPanel" type="PanelContainer"]
visible = false
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ConfirmationTitle" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.46, 0.86, 0.81, 1)
theme_override_font_sizes/font_size = 19
text = "确认行动"

[node name="ConfirmationSummary" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 15
autowrap_mode = 2

[node name="PaymentSummary" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.77, 0.38, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ConfirmationCancelButton" type="Button" parent="Margin/Layout/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
