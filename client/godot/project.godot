; Engine configuration file.
; Edit through Godot where possible so generated keys stay compatible.

config_version=5

[application]

config/name="SomeCardGameShit"
run/main_scene="res://scenes/bootstrap/Bootstrap.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="SomeCardGameShit"

[gui]

theme/custom="res://assets/themes/default_theme.tres"
theme/default_font_multichannel_signed_distance_field=true

[internationalization]

locale/fallback="zh_CN"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
