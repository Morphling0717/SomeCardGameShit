[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/UI/MulliganPanel.cs" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/components/GlassSurface.tscn" id="2_glass"]

[node name="MulliganPanel" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(640, 0)
theme_type_variation = &"GlassPanel"
mouse_filter = 0
script = ExtResource("1_script")

[node name="GlassSurface" parent="." instance=ExtResource("2_glass")]
show_behind_parent = true

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 2
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 2

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="StepBadge" type="PanelContainer" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(54, 30)
layout_mode = 2
theme_type_variation = &"PhaseChip"

[node name="Label" type="Label" parent="Margin/Layout/Header/StepBadge"]
layout_mode = 2
text = "调度"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionLabel"
theme_override_colors/font_color = Color(0.46, 0.86, 0.81, 1)
theme_override_font_sizes/font_size = 20
text = "选择要更换的起始手牌"
vertical_alignment = 1

[node name="MulliganSummary" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "选择要替换的手牌。"
autowrap_mode = 2

[node name="MulliganReview" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.78, 0.82, 1)
theme_override_font_sizes/font_size = 15
autowrap_mode = 2

[node name="Actions" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 10

[node name="SelectionHint" type="Label" parent="Margin/Layout/Actions"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "点击手牌切换选择"
vertical_alignment = 1

[node name="MulliganConfirmButton" type="Button" parent="Margin/Layout/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(176, 44)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
theme_override_font_sizes/font_size = 17
text = "确认调度"

[node name="MulliganAcknowledgeButton" type="Button" parent="Margin/Layout/Actions"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(236, 44)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
theme_override_font_sizes/font_size = 17
text = "已看清新手牌，准备交接"
