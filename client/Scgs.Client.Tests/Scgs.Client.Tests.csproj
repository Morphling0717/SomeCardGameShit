    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scgs.Client\Scgs.Client.csproj" />
    <ProjectReference Include="..\Scgs.Hotseat\Scgs.Hotseat.csproj" />
    <Compile Include="..\godot\scripts\Match\ViewerRevealGate.cs"
             Link="GodotContracts\ViewerRevealGate.cs" />
    <Compile Include="..\godot\scripts\Native\NativeLibraryLayout.cs"
             Link="GodotContracts\NativeLibraryLayout.cs" />
  </ItemGroup>

</Project>
