{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somecardgameshit.invalid/schemas/product-effects-1.0.0.json",
  "title": "Gate 5C executable product card programs",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "status", "default_definition", "definitions"],
  "properties": {
    "$schema": { "const": "./product-effects.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "status": { "const": "executable_product" },
    "default_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_status", "effects_compiled"],
      "properties": {
        "implementation_status": { "const": "executable_product" },
        "effects_compiled": { "const": true }
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "items": { "$ref": "#/$defs/definition" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "cardKind": { "enum": ["follower", "spell", "amulet", "trap", "field"] },
    "target": {
      "enum": [
        "none", "self", "friendly_follower", "enemy_follower",
        "friendly_permanent", "enemy_permanent"
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "threshold", "read_cap", "parameter", "permanent_filter"],
      "properties": {
        "kind": {
          "enum": [
            "always", "cracks_at_least", "cracks_at_most", "advanced", "on_time",
            "actual_repair_at_least", "repair_to_zero", "future_use_at_least",
            "turn_repair_at_least", "turn_future_use_at_least", "turn_barrier_granted",
            "turn_countdown_expired", "match_repair_to_zero_at_least",
            "match_countdown_expired_at_least", "leader_health_at_most",
            "board_count_less_than_opponent", "field_is", "controls_series_permanent"
          ]
        },
        "threshold": { "type": "integer", "minimum": 0 },
        "read_cap": { "type": "integer", "minimum": 0 },
        "parameter": { "type": "string" },
        "permanent_filter": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/permanentFilter" }]
        }
      }
    },
    "conditionExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "any"],
      "properties": {
        "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "permanentFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_card_types", "profession_id", "series_id",
        "include_main_board", "include_field", "exclude_source"
      ],
      "properties": {
        "allowed_card_types": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": { "$ref": "#/$defs/cardKind" }, "uniqueItems": true
        },
        "profession_id": { "type": "string" },
        "series_id": { "type": "string" },
        "include_main_board": { "type": "boolean" },
        "include_field": { "type": "boolean" },
        "exclude_source": { "type": "boolean" }
      }
    },
    "cardFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_card_types", "excluded_card_types", "profession_id", "series_id", "neutral"],
      "properties": {
        "allowed_card_types": {
          "type": "array", "items": { "$ref": "#/$defs/cardKind" }, "uniqueItems": true
        },
        "excluded_card_types": {
          "type": "array", "items": { "$ref": "#/$defs/cardKind" }, "uniqueItems": true
        },
        "profession_id": { "type": "string" },
        "series_id": { "type": "string" },
        "neutral": { "type": ["boolean", "null"] }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fixed", "multiplier", "cap"],
      "properties": {
        "source": { "enum": ["fixed", "actual_repair", "cracks"] },
        "fixed": { "type": "integer" },
        "multiplier": { "type": "integer" },
        "cap": { "type": "integer", "minimum": 0 }
      }
    },
    "once": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "key", "consumption"],
      "properties": {
        "scope": { "enum": ["owner_turn", "match", "source_owner_turn", "source_turn"] },
        "key": { "$ref": "#/$defs/nonEmptyString" },
        "consumption": { "enum": ["on_resolution", "on_trigger"] }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "trigger", "kind", "value"],
      "properties": {
        "effect_id": { "$ref": "#/$defs/nonEmptyString" },
        "trigger": {
          "enum": [
            "on_play", "on_entry", "on_evolve", "on_last_words", "on_countdown_end",
            "on_repair_to_zero", "on_future_used", "on_combat_kill_survived",
            "on_attack_declared", "on_actual_repair"
          ]
        },
        "kind": {
          "enum": [
            "draw", "heal_leader", "damage_follower", "repair_cracks", "modify_stats",
            "grant_keyword", "change_countdown", "summon_token", "search_top",
            "put_on_deck_bottom", "discard", "destroy_permanent", "cancel_attack"
          ]
        },
        "value": { "$ref": "#/$defs/value" },
        "secondary_amount": { "type": "integer" },
        "target": { "$ref": "#/$defs/target" },
        "conditions": { "$ref": "#/$defs/conditionExpr" },
        "duration": { "enum": ["immediate", "owner_turn", "permanent"] },
        "once": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/once" }] },
        "optional": { "type": "boolean" },
        "dependency": {
          "enum": ["none", "previous_effect_succeeded", "previous_draw_entered_hand"]
        },
        "depends_on_effect_id": { "type": ["string", "null"] },
        "parameter": { "type": "string" },
        "target_filter": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/permanentFilter" }]
        },
        "card_filter": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/cardFilter" }] },
        "keyword": { "type": ["string", "null"], "enum": [null, "ward", "rush", "storm", "barrier", "bane", "lifesteal"] },
        "reveal_count": { "type": "integer", "minimum": 0 },
        "selection_minimum": { "type": "integer", "minimum": 0 },
        "selection_maximum": { "type": "integer", "minimum": 0 },
        "randomize_remainder": { "type": "boolean" },
        "preserve_source_slot": { "type": "boolean" },
        "target_from_effect_id": { "type": ["string", "null"] },
        "trigger_player_relation": { "enum": ["any", "source_controller", "opponent_of_source_controller"] },
        "trigger_owner_turn_only": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "damage_follower", "modify_stats", "grant_keyword",
                  "change_countdown", "destroy_permanent"
                ]
              }
            }
          },
          "then": {
            "required": ["target"],
            "properties": { "target": { "not": { "const": "none" } } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "damage_follower" } } },
          "then": {
            "properties": {
              "target": { "enum": ["friendly_follower", "enemy_follower"] }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "destroy_permanent" } } },
          "then": {
            "required": ["target_filter"],
            "properties": {
              "target": { "enum": ["friendly_permanent", "enemy_permanent"] },
              "target_filter": { "$ref": "#/$defs/permanentFilter" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "grant_keyword" } } },
          "then": {
            "required": ["keyword"],
            "properties": {
              "keyword": { "enum": ["ward", "rush", "storm", "barrier", "bane", "lifesteal"] }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "summon_token" } } },
          "then": {
            "required": ["parameter"],
            "properties": { "parameter": { "$ref": "#/$defs/nonEmptyString" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "search_top" } } },
          "then": {
            "required": [
              "card_filter", "reveal_count", "selection_maximum", "randomize_remainder"
            ],
            "properties": {
              "card_filter": { "$ref": "#/$defs/cardFilter" },
              "reveal_count": { "type": "integer", "minimum": 1 },
              "selection_maximum": { "type": "integer", "minimum": 1 },
              "randomize_remainder": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["put_on_deck_bottom", "discard"] } }
          },
          "then": {
            "required": ["selection_maximum"],
            "properties": { "selection_maximum": { "type": "integer", "minimum": 1 } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "cancel_attack" } } },
          "then": { "properties": { "trigger": { "const": "on_attack_declared" } } }
        }
      ]
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode_id", "effects"],
      "properties": {
        "mode_id": { "$ref": "#/$defs/nonEmptyString" },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_id", "effects", "modes"],
      "properties": {
        "design_id": { "$ref": "#/$defs/nonEmptyString" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "modes": { "type": "array", "items": { "$ref": "#/$defs/mode" } }
      }
    }
  }
}
