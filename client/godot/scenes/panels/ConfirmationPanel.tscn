[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/UI/ConfirmationPanel.cs" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/components/GlassSurface.tscn" id="2_glass"]

[node name="ConfirmationPanel" type="PanelContainer"]
visible = false
theme_type_variation = &"GlassModal"
mouse_filter = 0
script = ExtResource("1_script")

[node name="GlassSurface" parent="." instance=ExtResource("2_glass")]
show_behind_parent = true

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ConfirmationTitle" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.46, 0.86, 0.81, 1)
theme_override_font_sizes/font_size = 19
theme_type_variation = &"SectionLabel"
text = "确认行动"

[node name="ConfirmationSummary" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 15
autowrap_mode = 2

[node name="PaymentSummary" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.77, 0.38, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ConfirmationCancelButton" type="Button" parent="Margin/Layout/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"IconButton"
theme_override_font_sizes/font_size = 16
text = "返回修改"

[node name="ActionConfirmButton" type="Button" parent="Margin/Layout/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"PrimaryButton"
theme_override_font_sizes/font_size = 16
text = "确认提交"
